<?xml version="1.0"?>
<!--
4-DOF arm matching ik_solver.py's geometry exactly (L1=10.5cm, L2=10cm, shoulder pivot at
the world origin, no base-height offset in the kinematic chain). See pybullet_sim.py for the
derivation of how each solved angle maps onto this chain's joints (the elbow joint needs
elbow_angle - 180 degrees; everything else feeds straight through).
Units: metres (PyBullet's default).
-->
<robot name="arm4dof">

  <material name="base_grey"><color rgba="0.22 0.27 0.30 1"/></material>
  <material name="link1_blue"><color rgba="0.29 0.56 0.85 1"/></material>
  <material name="link2_blue"><color rgba="0.42 0.66 0.90 1"/></material>
  <material name="grip_red"><color rgba="0.78 0.16 0.16 1"/></material>

  <!-- Fixed root: a plinth purely for looks, sitting BELOW the shoulder pivot at z=0 so it
       never shifts where the actual kinematic chain begins. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.03"/></geometry>
      <material name="base_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Zero-size stub so the base yaw and shoulder pitch can rotate about the SAME point
       (the origin) while still being two separate URDF joints. -->
  <link name="yaw_stub">
    <inertial><mass value="0.01"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>

  <joint name="base_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="yaw_stub"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="50" velocity="3"/>
  </joint>

  <!-- Upper arm: length L1 = 0.105 m, drawn along local +X (rotated from the cylinder's
       default +Z), so "shoulder angle = 0" means the link points straight out horizontally,
       matching forward_kinematics()'s elbow_pt formula. -->
  <link name="link1">
    <visual>
      <origin xyz="0.0525 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.011" length="0.105"/></geometry>
      <material name="link1_blue"/>
    </visual>
    <collision>
      <origin xyz="0.0525 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.011" length="0.105"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.0525 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="shoulder_pitch" type="revolute">
    <parent link="yaw_stub"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="50" velocity="3"/>
  </joint>

  <!-- Forearm: length L2 = 0.10 m. Zero angle here means "continues straight from link1" —
       this joint's angle is (elbow_angle_from_ik_solver - 180 degrees). -->
  <link name="link2">
    <visual>
      <origin xyz="0.05 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.009" length="0.10"/></geometry>
      <material name="link2_blue"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.009" length="0.10"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.05 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00008"/>
    </inertial>
  </link>

  <joint name="elbow_pitch" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.105 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="50" velocity="3"/>
  </joint>

  <!-- Gripper stub + two fingers, purely visual. Zero wrist angle = gripper axis continues
       straight from link2, matching how wrist_angle is derived in ik_solver.py. -->
  <link name="gripper_base">
    <visual>
      <origin xyz="0.012 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.008" length="0.024"/></geometry>
      <material name="grip_red"/>
    </visual>
    <collision>
      <origin xyz="0.012 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.008" length="0.024"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.012 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="wrist_pitch" type="revolute">
    <parent link="link2"/>
    <child link="gripper_base"/>
    <origin xyz="0.10 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="30" velocity="3"/>
  </joint>

  <link name="finger_left">
    <visual><origin xyz="0.02 0 0" rpy="0 0 0"/><geometry><box size="0.04 0.006 0.006"/></geometry><material name="grip_red"/></visual>
    <collision><origin xyz="0.02 0 0" rpy="0 0 0"/><geometry><box size="0.04 0.006 0.006"/></geometry></collision>
    <inertial><origin xyz="0.02 0 0"/><mass value="0.005"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="finger_left_mount" type="fixed">
    <parent link="gripper_base"/>
    <child link="finger_left"/>
    <origin xyz="0.024 0.012 0" rpy="0 0 0"/>
  </joint>

  <link name="finger_right">
    <visual><origin xyz="0.02 0 0" rpy="0 0 0"/><geometry><box size="0.04 0.006 0.006"/></geometry><material name="grip_red"/></visual>
    <collision><origin xyz="0.02 0 0" rpy="0 0 0"/><geometry><box size="0.04 0.006 0.006"/></geometry></collision>
    <inertial><origin xyz="0.02 0 0"/><mass value="0.005"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="finger_right_mount" type="fixed">
    <parent link="gripper_base"/>
    <child link="finger_right"/>
    <origin xyz="0.024 -0.012 0" rpy="0 0 0"/>
  </joint>

</robot>
